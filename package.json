{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.startsWith('pnpm/')) { console.error('このプロジェクトではpnpmのみ使用してください。npm/yarnは禁止です。'); process.exit(1); }\"",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "check:forbidden-libs": "node -e \"const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); const deps={...(p.dependencies||{}),...(p.devDependencies||{})}; const banned=['lucide-react','@heroicons/react','react-icons','feather-icons','@fortawesome/react-fontawesome']; const found=banned.filter((name)=>deps[name]); if(found.length){console.error('禁止ライブラリが含まれています: '+found.join(', ')); process.exit(1);} console.log('禁止ライブラリは検出されませんでした。');\"",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:scan": "node scripts/security-scan.mjs",
    "security:hook": "node scripts/cursor-security-hook.mjs",
    "test:security-scan": "node scripts/security-scan.test.mjs",
    "auth:test-security": "node --experimental-strip-types --test src/features/auth/authErrors.test.ts src/features/auth/authErrors.adversarial.test.ts src/features/auth/loginSecurityContract.test.ts src/features/auth/loginSourceSecurity.test.ts src/features/auth/platformMfaGate.test.ts src/features/auth/signOutSession.test.ts src/components/layout/BrandLogo.test.ts src/pages/Login/otpCodeUtils.test.ts src/pages/Login/setPasswordPolicy.test.ts src/pages/Login/needsPasswordSetup.test.ts src/pages/Login/mfaEnrollCopy.test.ts src/pages/Login/startPlatformAdminTotpEnroll.test.ts src/pages/AuthAudit/applyTrustedMapSvg.test.ts server/admins/markMustSetPassword.test.ts server/admins/invitePlatformAdmin.test.ts",
    "feedback:test-security": "node --experimental-strip-types --test src/features/feedback/feedbackSecurityContract.test.ts src/features/feedback/feedbackSourceSecurity.test.ts src/pages/Progress/isSafeGithubIssueUrl.test.ts server/feedback/canSendFeedback.test.ts server/feedback/submitFeedback.test.ts",
    "test:security-hook": "node scripts/cursor-security-hook.test.mjs",
    "test": "pnpm run lint && pnpm run type-check && pnpm run check:forbidden-libs && pnpm run version:check",
    "version:check": "node scripts/release.mjs check",
    "release": "node scripts/release.mjs",
    "test:app-version": "node scripts/app-version.test.mjs && node --experimental-strip-types --test src/config/appVersion.test.ts",
    "doctor": "node scripts/doctor.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:hard-boundaries": "node scripts/check-hard-boundaries.mjs",
    "test:hard-boundary-hook": "node scripts/cursor-safety-guard.test.mjs",
    "test:subagent-policy": "node scripts/cursor-subagent-guard.test.mjs",
    "test:memory-isolation": "node scripts/memory-isolation.test.mjs",
    "test:memory-audit": "node scripts/memory-audit.test.mjs",
    "test:loop-progress": "node scripts/loop-progress.test.mjs",
    "test:context-budget": "node scripts/context-budget.test.mjs",
    "test:claim-grounding": "node scripts/claim-grounding.test.mjs",
    "test:eval-template": "node scripts/eval-template.test.mjs",
    "test:failure-taxonomy": "node scripts/failure-taxonomy.test.mjs",
    "test:harness-simulation": "node scripts/harness-simulation.test.mjs",
    "test:working-graph": "node scripts/working-graph.test.mjs",
    "working-graph": "node scripts/working-graph.mjs",
    "contract:status": "node scripts/change-contract-gate.mjs status",
    "contract:pending": "node scripts/change-contract-gate.mjs pending",
    "contract:approve": "node scripts/change-contract-gate.mjs approve",
    "contract:close": "node scripts/change-contract-gate.mjs close",
    "memory:candidates": "node scripts/memory-candidates.mjs",
    "memory:audit": "node scripts/memory-audit.mjs",
    "isolate:status": "node scripts/isolate.mjs status",
    "isolate:recommend": "node scripts/isolate.mjs recommend",
    "isolate:worktree": "node scripts/isolate.mjs worktree",
    "isolate:shadow-branch": "node scripts/isolate.mjs shadow-branch",
    "loop:bugfix": "node scripts/loop-runner.mjs --mode=main-safe --goal=bug-fix --with-regression-guard",
    "loop:context": "node scripts/loop-context.mjs",
    "loop:discover": "node scripts/loop-discover.mjs",
    "loop:evaluate": "node scripts/loop-evaluate.mjs",
    "loop:evaluator": "node scripts/loop-evaluator.mjs",
    "loop:run": "node scripts/loop-runner.mjs --mode=main-safe --goal=main-doctor",
    "loop:ssot": "node scripts/loop-runner.mjs --mode=main-safe --goal=ssot-debt --with-regression-guard",
    "loop:ui": "node scripts/loop-runner.mjs --mode=main-safe --goal=ui-polish --with-regression-guard",
    "cursor:smoke": "node --experimental-strip-types scripts/cursor-sdk-smoke.ts",
    "cursor:test-env": "node --experimental-strip-types server/cursor/env.test.ts",
    "cursor:test-health": "node --experimental-strip-types server/cursor/healthGate.test.ts",
    "schedule:test-parse": "node --experimental-strip-types server/schedule/parseProposeResult.test.ts",
    "schedule:test-accuracy": "node --experimental-strip-types server/schedule/validateProposeResult.test.ts",
    "schedule:test-pack": "node --experimental-strip-types server/schedule/packProposeSlots.test.ts",
    "schedule:test-local": "node --experimental-strip-types server/schedule/buildLocalProposeSlots.test.ts",
    "schedule:test-prompt": "node --experimental-strip-types server/schedule/buildProposePrompt.test.ts",
    "schedule:test-memory-sections": "node --experimental-strip-types server/schedule/loadProposeMemorySections.test.ts",
    "schedule:test-travel": "node --experimental-strip-types src/utils/schedule/travelDistance.test.ts",
    "schedule:test-due": "node --experimental-strip-types src/utils/schedule/visitDueUrgency.test.ts",
    "cursor:test-usage": "node --experimental-strip-types server/cursor/usageTypes.test.ts",
    "calendar:test-composing": "node --experimental-strip-types --test src/components/ui/ComposingOrb.test.ts src/pages/Calendar/components/AiComposingOverlay.test.ts src/pages/Calendar/components/GapFillPanel.test.ts src/pages/Proposals/sections/GenerateProposalSection.test.ts",
    "feedback:test": "node --experimental-strip-types --test server/feedback/buildIssue.test.ts server/feedback/githubIssues.test.ts server/feedback/publicErrors.test.ts server/feedback/submitFeedback.test.ts src/features/feedback/feedbackCopy.test.ts src/features/feedback/sendOnEnterPolicy.test.ts src/features/feedback/pickFeedbackThread.test.ts src/features/feedback/unreadReplyPolicy.test.ts src/components/ui/Switch.test.ts src/components/features/feedback/FeedbackChatPanel.test.ts src/components/features/feedback/FeedbackChatLauncher.test.ts src/components/features/feedback/FeedbackUnreadDot.test.ts src/components/features/feedback/shouldCloseFeedbackOnOutsideClick.test.ts src/pages/Security/securityCopy.test.ts src/pages/Progress/improvementItemPolicy.test.ts src/pages/Progress/formatImprovementItem.test.ts src/pages/Progress/improvementAnnouncement.test.ts src/pages/Progress/clinicReplyMigration.test.ts src/components/layout/accountMenuLinks.test.ts"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.27",
    "@supabase/supabase-js": "2.49.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.28.0",
    "thinking-orbs": "0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  },
  "packageManager": "pnpm@10.16.0"
}
