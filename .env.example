# Dentacle / Supabase（フロント公開用）
# 値は Supabase Dashboard → Project Settings → API からコピーしてください。
# service_role は絶対に VITE_ を付けないでください。

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# 任意: アプリ表示名
VITE_APP_NAME=Dentacle

# ---------------------------------------------------------------------------
# サーバー専用（Vercel api/ / ローカル smoke など）
# フロントの Vite バンドルに載せないこと（VITE_ を付けない）
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# 運営招待メールの戻り先。未設定時は localhost または許可した Origin
# APP_ORIGIN=http://localhost:5173

# Cursor SDK（MEMORY §6.10 / §6.14）
# runtime: 開発・手元デバッグ = local / 本番（お客さんがボタンを押す）= cloud
# Private リポでも Cloud は使える（Cursor に GitHub 連携があれば可）。公開必須ではない。
CURSOR_API_KEY=
CURSOR_RUNTIME=local
# フォールバック既定 = Grok 4.5。実行モデルの正は運営画面の切替（grok-4.5 / grok-4.6 / composer-2.5）
CURSOR_MODEL_ID=grok-4.5
CURSOR_LOCAL_CWD=.
# Cloud 用リポジトリ（正）
CURSOR_CLOUD_REPO_URL=https://github.com/nishimura-yuya-git/dentacle
CURSOR_CLOUD_STARTING_REF=main
# GET /api/cursor/health 用 Bearer シークレット（未設定時は常に 401）
# フロント（VITE_）に出さない。本番 Vercel にも同名で設定する
CURSOR_HEALTH_SECRET=

# 自動提案のクールダウンはコード定数（PROPOSE_COOLDOWN_MS=60s・クリニック単位）
# 環境変数では切り替えない。連打抑制は server/schedule/proposeRateLimit.ts を参照

# 自動提案エンジン。既定 cursor = Cursor SDK
# 方針: 実行時に PROJECT_MEMORY.md の割付関連節を自動抽出してプロンプトへ埋め込む
# .cursor/rules 全文は渡さない（精度のため。割付記憶は MEMORY に集約）
# cursor | auto（SDK優先・失敗/0件時のみローカル）| local（速度検証用）
PROPOSE_ENGINE=cursor

# カレンダー自動提案 API（サーバー）。開発は Vite middleware / 本番は Vercel api/schedule/propose
# SUPABASE_URL / SUPABASE_ANON_KEY は未設定時 VITE_SUPABASE_* を流用可
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ご意見チャット → GitHub Issue（サーバー専用。VITE_ 禁止）
# 細粒度 PAT: Issues Read and Write（対象リポジトリのみ）
GITHUB_FEEDBACK_TOKEN=
# 省略時は CURSOR_CLOUD_REPO_URL、さらに既定 nishimura-yuya-git/dentacle
# GITHUB_FEEDBACK_REPO=nishimura-yuya-git/dentacle

# ローカル専用（Apotool 住所スクレイプ）。値は Git に書かない
# APOTOOL_OFFICE_KEY=
# APOTOOL_COOKIE=
